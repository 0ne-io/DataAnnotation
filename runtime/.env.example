# Stack Exchange API (optional, for SO style fetch)
# STACKEXCHANGE_KEY=

# OpenAI (default provider)
OPENAI_API_KEY=sk-your-key-here
# Optional: compatible API base URL
# OPENAI_BASE_URL=https://api.openai.com/v1
HUMANIZE_MODEL=gpt-4o-mini

# Anthropic (Claude) — set HUMANIZE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# HUMANIZE_MODEL=claude-sonnet-4-20250514

# Or use local Ollama instead:
# HUMANIZE_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
